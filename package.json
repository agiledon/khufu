{
  "name": "khufu-kit",
  "version": "0.4.2",
  "description": "Test generation skill framework for AI IDEs, following the test pyramid methodology. Provides /khufu-ut, /khufu-it, /khufu-api, /khufu-e2e, /khufu-harness, and /khufu-to-prd skills.",
  "type": "module",
  "bin": {
    "khufu": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "skills/",
    ".claude-plugin/",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "setup": "bash scripts/link.sh",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "testing",
    "test-pyramid",
    "unit-test",
    "integration-test",
    "api-test",
    "e2e-test",
    "claude-code",
    "skill",
    "tdd",
    "khufu-kit"
  ],
  "author": {
    "name": "Khufu Authors"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agiledon/khufu"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.3.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
