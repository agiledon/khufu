{
  "name": "khufu",
  "version": "0.1.0",
  "description": "Test generation skill framework for AI IDEs, following the test pyramid methodology",
  "type": "module",
  "bin": {
    "khufu": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "skills/",
    ".claude-plugin/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "testing",
    "test-pyramid",
    "unit-test",
    "integration-test",
    "api-test",
    "e2e-test",
    "claude-code",
    "skill",
    "tdd"
  ],
  "author": {
    "name": "Khufu Authors"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/khufu-framework/khufu"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.3.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
